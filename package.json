{
  "name": "global-contact-research-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:redteam": "vitest run tests/redteam",
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev --workspace=apps/web"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.15",
    "zod": "^4.6.5"
  }
}
